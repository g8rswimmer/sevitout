# PostgreSQL (docker-compose)
POSTGRES_DB=sevitout
POSTGRES_USER=sevitout
POSTGRES_PASSWORD=sevitout

# API server
DATABASE_URL=postgres://sevitout:sevitout@localhost:5432/sevitout?sslmode=disable
JWT_SECRET=
JWT_TTL_HOURS=24
ENCRYPTION_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional integrations
PAGERDUTY_API_KEY=
GITHUB_TOKEN=

# Slack bot
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
API_GRPC_ADDR=api:8080
SLACKBOT_SERVICE_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:8080

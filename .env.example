# PostgreSQL (docker-compose)
POSTGRES_DB=sevitout
POSTGRES_USER=sevitout
POSTGRES_PASSWORD=sevitout

# API server
# Uses localhost for host-machine connections; must stay in sync with POSTGRES_* vars above.
# Inside Docker, service-to-service connections use the `postgres` hostname instead.
DATABASE_URL=postgres://sevitout:sevitout@localhost:5432/sevitout?sslmode=disable
JWT_SECRET=
JWT_TTL_HOURS=24
ENCRYPTION_KEY=

# Optional integrations
PAGERDUTY_API_KEY=
GITHUB_TOKEN=

# Slack bot (all five required together — see demo/M11-slack-bot.md for how
# to obtain them; the slackbot container exits cleanly if any are unset).
# SLACKBOT_SERVICE_EMAIL/PASSWORD are the bot's own login for the API server
# (an ordinary registered user promoted to Admin) — it logs itself in and
# refreshes its own token, so there's no JWT to generate or rotate by hand.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
API_GRPC_ADDR=api:8080
SLACKBOT_SERVICE_EMAIL=
SLACKBOT_SERVICE_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8080

          "description": "snapshot_url links to an already-hosted image of the monitoring chart at\ndetection time; rendered as an inline preview in the UI. No file upload\nis supported — this is a URL to an image hosted elsewhere."
        },
        "githubRepo": {
          "type": "string",
          "description": "github_repo is the \"owner/repo\" this SEV's code lives in (e.g.\n\"acme-corp/checkout-service\"); pre-fills TaskService.CreateGitHubIssue's\nowner/repo fields in the web UI. Set via UpdateSEV, not at creation."
        },
        "rootCauseReferenceUrl": {
          "type": "string",
          "description": "root_cause_reference_url links to the concrete change that caused the\nincident — e.g. a PR/commit diff or a config-management change —\nalongside root_cause_category/root_cause_description's classification\nand narrative. Set via UpdateSEV, not at creation."
        },
        "query": {
          "type": "string",
          "description": "query is a saved query/expression (e.g. PromQL or a Datadog query\nstring) run against monitoring_tool — a separate concept from\ndashboard_url, not a URL (§13.4)."
        }

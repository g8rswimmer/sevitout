    "/v1/config/integration-catalog": {
      "get": {
        "summary": "GetIntegrationCatalog returns the fixed, ordered field schema for every\nintegration_type this server recognizes (docs/roadmap.md Phase 9) — a\npure translation of internal/integrations/catalog.All with no store\naccess. It's the single source of truth the admin UI renders its\nsidebar + schema-driven detail form from, and UpsertIntegrationConfig\nvalidates incoming requests against the same catalog.",
        "operationId": "ConfigService_GetIntegrationCatalog",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetIntegrationCatalogResponse"
            }

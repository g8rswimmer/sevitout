    "/v1/config/integrations/slack/bot-credential": {
      "get": {
        "summary": "GetSlackBotCredential returns the decrypted \"slack\" integration\ncredential pair (bot_token/app_token) — the one deliberate exception to\n\"credentials are never returned by any RPC in this service\" above. It\nexists solely so cmd/slackbot (a separate process that only talks to\nthis API over gRPC, with no direct datastore/encryption-key access) can\npick up a datastore-configured Slack token without a restart; see\ndocs/roadmap.md Phase 8. Gated server-side to the specific slackbot\nservice account (SLACKBOT_SERVICE_EMAIL), not merely Admin+ — an\nunrelated admin session must not be able to pull plaintext Slack tokens\nthrough this call. Returns empty fields (not an error) when the \"slack\"\nintegration has no credentials configured, so callers can fall back to\ntheir own static tokens.",
        "operationId": "ConfigService_GetSlackBotCredential",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetSlackBotCredentialResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "ConfigService"
        ]
      }
    },
    "/v1/config/integrations/{integrationType}": {
      "get": {
        "operationId": "ConfigService_GetIntegrationConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1IntegrationConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "integrationType",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ConfigService"
        ]
      },
      "put": {
        "summary": "UpsertIntegrationConfig creates or replaces the settings and credentials\nfor one integration type. Credentials are encrypted (AES-256-GCM) before\nbeing written to storage and are never returned by any RPC in this\nservice — only whether credentials are currently configured. The\nintegration_type and every credential/settings key (and, for a select\nfield, its value) are validated against GetIntegrationCatalog's schema\nbefore anything is written — see this RPC's handler doc comment.",
        "operationId": "ConfigService_UpsertIntegrationConfig",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1IntegrationConfigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "integrationType",
            "description": "integration_type: one of GetIntegrationCatalog's fixed set — e.g.\n\"slack\", \"pagerduty\", \"github\", \"jira\", \"monitoring\". Any other value is\nrejected.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ConfigServiceUpsertIntegrationConfigBody"
            }
          }
        ],
        "tags": [
          "ConfigService"
        ]
      }
    },
